---
import { business, services } from '../data/business';
---
<footer>
  <div class="container">
    <p><strong>{business.name}</strong> · {business.address.streetAddress} · {business.address.postalCode} {business.address.addressLocality}</p>
    <p>
      Telefon: <a href={`tel:${business.phone.tel}`}>{business.phone.display}</a>
      · E-Mail: <a href={`mailto:${business.email}`}>{business.email}</a>
    </p>
    <p>
      {services.map((s, i) => (
        <Fragment>{i > 0 ? ' · ' : ''}<a href={`/${s.slug}`}>{s.name}</a></Fragment>
      ))}
    </p>
    <p>
      <a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a>
    </p>
    <p>
      Partner: <a href="https://www.alberk.de/" rel="noopener">ALBERK Fußbodentechnik</a>
      · Website &amp; Sichtbarkeit: <a href="https://systemic-automation.de/sichtbarkeit" rel="noopener">Systemic Automation</a>
    </p>
  </div>
</footer>
