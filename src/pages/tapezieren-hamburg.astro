---
import type { FaqItem } from '../data/business';
import ServiceLayout from '../layouts/ServiceLayout.astro';

const bereiche = [
  {
    h: 'Was wir tapezieren',
    items: [
      'Vliestapete, auch überstreichbar',
      'Raufaser mit anschließendem Anstrich',
      'Designtapeten und Mustertapeten mit Rapport',
      'Fototapete und großformatige Wandbilder',
      'Strukturtapeten und Glasvlies',
    ],
  },
  {
    h: 'Was dazugehört',
    items: [
      'Alttapete entfernen und Kleisterreste abwaschen',
      'Löcher und Risse spachteln, Untergrund grundieren',
      'Möbel abdecken, Böden schützen, besenrein übergeben',
      'Auf Wunsch direkt weiter mit dem <a href="/malerarbeiten-hamburg">Anstrich</a>',
    ],
  },
  {
    h: 'Wo wir tapezieren',
    items: [
      'Wohnungen, von der einzelnen Wand bis zur kompletten Etage',
      'Treppenhäuser für Hausverwaltungen',
      'Büros und Gewerbeflächen',
      'Altbauwohnungen mit unebenen Wänden',
    ],
  },
];

const faqItems: FaqItem[] = [
  {
    q: 'Was kostet Tapezieren in Hamburg?',
    a: 'Der Preis hängt von Tapetenart, Wandzustand und Fläche ab. Deshalb gibt es keinen Quadratmeterpreis von der Stange, sondern ein schriftliches Festpreisangebot nach dem kostenlosen Vor-Ort-Termin. Für den Anstrich auf Raufaser oder Vlies gelten unsere Malerpreise ab 9,64 € pro m² inklusive Mehrwertsteuer.',
  },
  {
    q: 'Entfernen Sie auch die alte Tapete?',
    a: 'Ja. Alttapete kommt runter, Kleisterreste werden abgewaschen, Löcher und Risse gespachtelt und der Untergrund grundiert. Erst dann geht die neue Bahn an die Wand.',
  },
  {
    q: 'Welche Tapete eignet sich für unebene Altbauwände?',
    a: 'Bei unebenen Wänden ist eine Vliestapete oder eine Spachtelung oft besser als ein reiner Glattanstrich. Was bei Ihren Wänden sinnvoll ist, sieht Mehmet Sert beim Vor-Ort-Termin.',
  },
  {
    q: 'Tapezieren Sie auch Treppenhäuser für Hausverwaltungen?',
    a: 'Ja. Wir tapezieren und streichen Treppenhäuser und Gemeinschaftsflächen für Hausverwaltungen und Gewerbe in Hamburg und Umland, mit schriftlichem Festpreisangebot.',
  },
  {
    q: 'Müssen wir die Möbel selbst ausräumen?',
    a: 'Wir decken Böden und Möbel sorgfältig ab. Großmöbel schützen wir an Ort und Stelle. Was umgestellt werden sollte, besprechen wir beim kostenlosen Vor-Ort-Termin.',
  },
];
---
<ServiceLayout
  title="Tapezieren Hamburg » Tapezierarbeiten zum Festpreis ✓"
  description="Tapezierarbeiten in Hamburg ✓ Vlies, Raufaser, Designtapete, Fototapete ✓ Alttapete entfernen inklusive, Festpreis nach Besichtigung. ☎ 0173 8615002"
  path="/tapezieren-hamburg"
  ogImage="https://maler-sert.de/img/malerarbeiten-weisse-farbrolle.webp"
  ogImageAlt="Tapezierarbeiten und Malerarbeiten in Hamburg"
  eyebrow="Tapezieren · Hamburg · seit 2002"
  heroTitle="Tapezier&shy;arbeiten in Hamburg — <strong>Bahn für Bahn sauber.</strong>"
  lead="Vlies, Raufaser, Designtapete — wir entfernen die alte Tapete, bereiten den Untergrund vor und tapezieren Wohnungen, Treppenhäuser und Gewerbeflächen zum Festpreis."
  img="/img/malerarbeiten-weisse-farbrolle.jpg"
  imgWebp="/img/malerarbeiten-weisse-farbrolle.webp"
  imgAlt="Malerwerkzeug für Tapezier- und Malerarbeiten"
  rollerCrop={true}
  waText="Hallo Herr Sert, ich brauche Tapezierarbeiten in Hamburg."
  breadcrumbName="Tapezieren Hamburg"
  serviceName="Tapezierarbeiten Hamburg"
  serviceDescription="Tapezierarbeiten in Hamburg: Vliestapete, Raufaser, Designtapeten, Fototapete. Alttapete entfernen und Untergrund vorbereiten inklusive. Festpreis nach Vor-Ort-Termin. Maler Sert GmbH seit 2002."
  faqItems={faqItems}
  faqTitle="Häufige Fragen zum Tapezieren in Hamburg."
>
  <section>
    <div class="container">
      <p class="section-kicker">Was wir machen</p>
      <h2>Tapete runter, Untergrund vorbereiten, neu tapezieren.</h2>
      <p class="section-intro">
        Eine neue Tapete hält nur so gut wie der Untergrund darunter. Deshalb prüfen wir die Wand,
        bevor die erste Bahn hängt — gerade im Hamburger
        <a href="/#altbau">Altbau</a> mit Kalkputz und Rissen. Wo nötig, übernehmen wir auch
        <a href="/trockenbau-hamburg">Spachtel- und Trockenbauarbeiten</a>.
      </p>
      <div class="leistung-list">
        {bereiche.map((b) => (
          <div class="leistung-item">
            <h3 set:html={b.h}></h3>
            <ul>{b.items.map((li) => <li set:html={li}></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <p class="section-kicker">Preise</p>
      <h2>Festpreis nach Besichtigung.</h2>
      <p class="section-intro">
        Tapetenart, Wandzustand und Fläche bestimmen den Aufwand. Mehmet Sert schaut sich die Räume
        kostenlos an und macht danach ein schriftliches Festpreisangebot — ohne Stundensatz.
        Kommt ein Anstrich dazu, gelten unsere <a href="/malerarbeiten-hamburg">Malerpreise</a>
        ab 9,64 € pro m² inklusive Mehrwertsteuer.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="section-kicker">Ablauf</p>
      <h2>In drei Schritten zur neuen Tapete.</h2>
      <ol class="ablauf">
        <li class="ablauf-step">
          <span class="step-num" aria-hidden="true">1</span>
          <h3>Anrufen oder schreiben</h3>
          <p>Kurz beschreiben, welche Räume und welche Tapete. Meldung innerhalb eines Werktags.</p>
        </li>
        <li class="ablauf-step">
          <span class="step-num" aria-hidden="true">2</span>
          <h3>Kostenloser Vor-Ort-Termin</h3>
          <p>Mehmet Sert prüft die Wände, berät zur Tapetenart und nimmt Maß.</p>
        </li>
        <li class="ablauf-step">
          <span class="step-num" aria-hidden="true">3</span>
          <h3>Schriftliches Festpreisangebot</h3>
          <p>Sie sagen zu, wir setzen den Termin und übergeben besenrein.</p>
        </li>
      </ol>
    </div>
  </section>
</ServiceLayout>
